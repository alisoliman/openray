<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys the generated Info.plist can't express. Xcode merges this file with the
     INFOPLIST_KEY_* build settings. It lives outside OpenRay/ so the synchronized
     folder doesn't copy it into the bundle as a resource. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openray</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
